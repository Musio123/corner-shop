# Copy this file to ".env.local" and fill in the values (see README.md for where to find each one).

# --- Database (Neon OR Supabase) ---
# Neon: Dashboard > Connect > copy the connection string
# Supabase: Project > Connect > "Transaction pooler" connection string (replace [YOUR-PASSWORD])
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# The address your site runs on
NEXTAUTH_URL="http://localhost:3000"
# Any long random string (see README for how to generate one)
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# --- Google login (Google Cloud Console) ---
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# --- Brevo (transactional email) ---
# Brevo: SMTP & API > API Keys > create/copy an API key
BREVO_API_KEY="xkeysib-your-api-key"
# A verified "sender" email/name. Verify a sender at
# Brevo > Senders, Domains & Dedicated IPs > Senders (must be confirmed).
BREVO_FROM_EMAIL="no-reply@yourdomain.com"
BREVO_FROM_NAME="Corner Shop"
